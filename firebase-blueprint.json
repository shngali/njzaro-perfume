{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "Client reviews and ratings for perfumes",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the reviewer"
        },
        "text": {
          "type": "string",
          "description": "Review commentary text"
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when review was submitted"
        }
      },
      "required": ["name", "text", "rating"]
    },
    "Product": {
      "title": "Product",
      "description": "Perfume product catalog entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Numeric product identifier"
        },
        "brand": {
          "type": "string",
          "description": "Fragrance brand or house"
        },
        "name": {
          "type": "string",
          "description": "Fragrance title"
        },
        "notes": {
          "type": "string",
          "description": "Olfactory notes"
        },
        "category": {
          "type": "string",
          "description": "Brand category"
        },
        "badge": {
          "type": "string",
          "description": "Optional status badge like New, Sale, or discount tag"
        },
        "discountPercent": {
          "type": "number",
          "description": "Percentage discount applied to product"
        },
        "inStock": {
          "type": "boolean",
          "description": "Whether the perfume is currently in stock"
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether to feature the fragrance prominently"
        },
        "img": {
          "type": "string",
          "description": "Image URL"
        },
        "sizes": {
          "type": "array",
          "description": "Available bottle and decant sizes, current prices and original prices"
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Soft deletion tombstone marker"
        }
      },
      "required": ["brand", "name", "notes", "sizes"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store announcement and contact configurations",
      "type": "object",
      "properties": {
        "announcement": {
          "type": "string",
          "description": "Top promotional banner text"
        },
        "whatsappNumber": {
          "type": "string",
          "description": "Primary WhatsApp order recipient phone number"
        },
        "deliveryFee": {
          "type": "number",
          "description": "Standard delivery fee in IQD"
        },
        "announcementActive": {
          "type": "boolean",
          "description": "Whether the top announcement banner is visible"
        }
      }
    }
  },
  "firestore": {
    "/njzaro_reviews/{reviewId}": {
      "schema": "Review",
      "description": "Collection of verified client reviews and ratings"
    },
    "/njzaro_products/{productId}": {
      "schema": "Product",
      "description": "Collection of admin managed perfume products"
    },
    "/njzaro_settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Global store configuration managed by owner"
    }
  }
}
